# Source, tests, and local tooling
src/**
sandbox-server/**
test/**
out/test/**
out/webview/**
.vscode/**
.vscode-test/**
.vscode-test.js
scripts/**
# The local @tauren/shared runtime dependency is shipped through node_modules.
# Do not include its source project or nested development dependencies as well.
shared/**
node_modules/@tauren/shared/src/**
node_modules/@tauren/shared/test/**
node_modules/@tauren/shared/scripts/**
node_modules/@tauren/shared/tsconfig*.json
node_modules/@tauren/shared/package-lock.json
.npmrc
tsconfig.json

# Project-only docs/assets not needed at runtime
AGENTS.md
TODO.md
plan/**
docs/**
.fallow/**
.fallowrc.jsonc

# Repository metadata and generated packages
.git/**
.gitignore
.vscodeignore
*.vsix

# Build metadata and development-only dependency metadata
out/**/*.map
node_modules/**/*.map
node_modules/**/*.d.ts
node_modules/**/*.d.mts
node_modules/**/*.d.cts

# SDK source dependency is bundled into resources/pi-sdk-runtime/sdk/piSdkBundle.mjs.
# Generated peer shims under resources/pi-sdk-runtime/sdk/node_modules are required at runtime.
node_modules/@earendil-works/pi-coding-agent/**

# Documentation/demo captures are not needed at runtime
resources/*.gif
# Source descriptors are staged as separate generated kits during compile.
resources/sbx-kit/**
